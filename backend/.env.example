# ─── App ───────────────────────────────────────────
APP_NAME="Shoshos Oil and Gas Intl. Limited API"
APP_DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production

# ─── Database ──────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
# Local development (no PostgreSQL or Supabase needed)
DATABASE_URL=sqlite+aiosqlite:///./shoshos.db
# Optional PostgreSQL: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME

# ─── CORS ──────────────────────────────────────────
# Comma-separated list handled in config.py
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3100","https://shoshosltd.com"]

# ─── Email (SendGrid) ──────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@shoshosltd.com
ADMIN_EMAIL=admin@shoshosltd.com

# ─── Default Admin Account (change after first login) ──
ADMIN_EMAIL_DEFAULT=admin@shoshosltd.com
ADMIN_PASSWORD_DEFAULT=ChangeMe123!
ADMIN_SEED_SECRET=replace-with-a-random-secret
